<workout_file>
    <author>Trainingsplan</author>
    <name>Schwelle 3x15</name>
    <description>Schwelle: 3 x 15 Minuten bei 263 W (97 % der FTP), dazwischen 5 Minuten locker.
Im ERG-Modus, Trittfrequenz 85-95. Hart, aber gleichmaessig durchzufahren (RPE 7).
Wird ein Intervall im ERG-Modus zu schwer, die Trittfrequenz hoch halten; faellt sie
unter 80 und kommt nicht mehr hoch, das Intervall beenden und locker weiterfahren.
Flasche mit 40-60 g Kohlenhydraten, ab dem Einfahren trinken.

Gesamtdauer 80 min. Die Wattwerte gelten fuer eine FTP von 271 W in MyWhoosh.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Schwelle"/>
    </tags>
    <workout>

        <!-- Einfahren: 10 min Rampe 122 auf 190 W -->
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.70" pace="0">
            <textevent timeoffset="10" message="Einfahren. 10 Minuten locker steigern."/>
            <textevent timeoffset="300" message="Haelfte. Trittfrequenz 90-95."/>
        </Warmup>

        <!-- 4 min bei 190 W -->
        <SteadyState Duration="240" Power="0.70" pace="0">
            <textevent timeoffset="10" message="Gleichmaessig bei 190 W."/>
            <textevent timeoffset="120" message="Ab jetzt regelmaessig aus der Flasche trinken."/>
        </SteadyState>

        <!-- 3 x 30 s bei 298 W / 1 min bei 136 W -->
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="60"
                    OnPower="1.10" OffPower="0.50" pace="0"/>

        <!-- 1:30 min bei 136 W -->
        <SteadyState Duration="90" Power="0.50" pace="0">
            <textevent timeoffset="5" message="Gleich Intervall 1/3: 15 min bei 263 W."/>
            <textevent timeoffset="75" message="15 Sekunden."/>
        </SteadyState>

        <!-- 15 min bei 263 W -->
        <SteadyState Duration="900" Power="0.97" pace="0">
            <textevent timeoffset="5" message="Intervall 1/3: 15 min bei 263 W. Trittfrequenz 85-95."/>
            <textevent timeoffset="450" message="Haelfte."/>
            <textevent timeoffset="600" message="Noch 5 Minuten."/>
            <textevent timeoffset="840" message="Noch 1 Minute."/>
        </SteadyState>

        <!-- 5 min bei 136 W -->
        <SteadyState Duration="300" Power="0.50" pace="0">
            <textevent timeoffset="5" message="5 Minuten locker. Trinken."/>
            <textevent timeoffset="240" message="Noch 1 Minute, dann Intervall 2/3."/>
        </SteadyState>

        <!-- 15 min bei 263 W -->
        <SteadyState Duration="900" Power="0.97" pace="0">
            <textevent timeoffset="5" message="Intervall 2/3: 15 min bei 263 W. Trittfrequenz 85-95."/>
            <textevent timeoffset="450" message="Haelfte."/>
            <textevent timeoffset="600" message="Noch 5 Minuten."/>
            <textevent timeoffset="840" message="Noch 1 Minute."/>
        </SteadyState>

        <!-- 5 min bei 136 W -->
        <SteadyState Duration="300" Power="0.50" pace="0">
            <textevent timeoffset="5" message="5 Minuten locker. Trinken."/>
            <textevent timeoffset="240" message="Noch 1 Minute, dann Intervall 3/3."/>
        </SteadyState>

        <!-- 15 min bei 263 W -->
        <SteadyState Duration="900" Power="0.97" pace="0">
            <textevent timeoffset="5" message="Intervall 3/3: 15 min bei 263 W. Trittfrequenz 85-95."/>
            <textevent timeoffset="450" message="Haelfte."/>
            <textevent timeoffset="600" message="Noch 5 Minuten."/>
            <textevent timeoffset="840" message="Noch 1 Minute."/>
        </SteadyState>

        <!-- Ausfahren: 5 min Rampe 149 auf 108 W -->
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40" pace="0">
            <textevent timeoffset="5" message="Geschafft. Locker ausfahren."/>
        </Cooldown>

    </workout>
</workout_file>
