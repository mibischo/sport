<workout_file>
    <author>Trainingsplan</author>
    <name>Sweetspot 3x20</name>
    <description>Sweetspot: 3 x 20 Minuten bei 247 W (91 % der FTP), dazwischen 5 Minuten locker.
Im ERG-Modus, Trittfrequenz 85-95. Soll sich zaeh, aber kontrollierbar anfuehlen (RPE 5-6).
Flasche mit 40-60 g Kohlenhydraten, ab dem Einfahren trinken.

Gesamtdauer 95 min. Die Wattwerte gelten fuer eine FTP von 271 W in MyWhoosh.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweetspot"/>
    </tags>
    <workout>

        <!-- Einfahren: 10 min Rampe 122 auf 190 W -->
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.70" pace="0">
            <textevent timeoffset="10" message="Einfahren. 10 Minuten locker steigern."/>
            <textevent timeoffset="300" message="Haelfte. Trittfrequenz 90-95."/>
        </Warmup>

        <!-- 4 min bei 190 W -->
        <SteadyState Duration="240" Power="0.70" pace="0">
            <textevent timeoffset="10" message="Gleichmaessig bei 190 W."/>
            <textevent timeoffset="120" message="Ab jetzt regelmaessig aus der Flasche trinken."/>
        </SteadyState>

        <!-- 3 x 30 s bei 298 W / 1 min bei 136 W -->
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="60"
                    OnPower="1.10" OffPower="0.50" pace="0"/>

        <!-- 1:30 min bei 136 W -->
        <SteadyState Duration="90" Power="0.50" pace="0">
            <textevent timeoffset="5" message="Gleich Intervall 1/3: 20 min bei 247 W."/>
            <textevent timeoffset="75" message="15 Sekunden."/>
        </SteadyState>

        <!-- 20 min bei 247 W -->
        <SteadyState Duration="1200" Power="0.91" pace="0">
            <textevent timeoffset="5" message="Intervall 1/3: 20 min bei 247 W. Trittfrequenz 85-95."/>
            <textevent timeoffset="600" message="Haelfte."/>
            <textevent timeoffset="900" message="Noch 5 Minuten."/>
            <textevent timeoffset="1140" message="Noch 1 Minute."/>
        </SteadyState>

        <!-- 5 min bei 136 W -->
        <SteadyState Duration="300" Power="0.50" pace="0">
            <textevent timeoffset="5" message="5 Minuten locker. Trinken."/>
            <textevent timeoffset="240" message="Noch 1 Minute, dann Intervall 2/3."/>
        </SteadyState>

        <!-- 20 min bei 247 W -->
        <SteadyState Duration="1200" Power="0.91" pace="0">
            <textevent timeoffset="5" message="Intervall 2/3: 20 min bei 247 W. Trittfrequenz 85-95."/>
            <textevent timeoffset="600" message="Haelfte."/>
            <textevent timeoffset="900" message="Noch 5 Minuten."/>
            <textevent timeoffset="1140" message="Noch 1 Minute."/>
        </SteadyState>

        <!-- 5 min bei 136 W -->
        <SteadyState Duration="300" Power="0.50" pace="0">
            <textevent timeoffset="5" message="5 Minuten locker. Trinken."/>
            <textevent timeoffset="240" message="Noch 1 Minute, dann Intervall 3/3."/>
        </SteadyState>

        <!-- 20 min bei 247 W -->
        <SteadyState Duration="1200" Power="0.91" pace="0">
            <textevent timeoffset="5" message="Intervall 3/3: 20 min bei 247 W. Trittfrequenz 85-95."/>
            <textevent timeoffset="600" message="Haelfte."/>
            <textevent timeoffset="900" message="Noch 5 Minuten."/>
            <textevent timeoffset="1140" message="Noch 1 Minute."/>
        </SteadyState>

        <!-- Ausfahren: 5 min Rampe 149 auf 108 W -->
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40" pace="0">
            <textevent timeoffset="5" message="Geschafft. Locker ausfahren."/>
        </Cooldown>

    </workout>
</workout_file>
